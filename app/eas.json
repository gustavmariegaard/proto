{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "SÆT_SUPABASE_URL_HER",
        "EXPO_PUBLIC_SUPABASE_KEY": "SÆT_PUBLISHABLE_KEY_HER"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SUPABASE_URL": "SÆT_SUPABASE_URL_HER",
        "EXPO_PUBLIC_SUPABASE_KEY": "SÆT_PUBLISHABLE_KEY_HER"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
